{
	"$schema": "vscode://schemas/color-theme",
	"name": "Paradox - Quiet Light",
	"type": "light",
	"author": "cwtools-md-edition",
	"semanticHighlighting": true,
	"comment": "Token scopes defined by cwtools/paradox-syntax (Thomas Boby, MIT, https://github.com/cwtools/paradox-syntax). Quiet Light scheme (originally CKII - Quiet Light by UristMcDorf) with its purple-accented workbench colors preserved.",
	"colors": {
		"activityBar.background": "#ededf5",
		"activityBar.foreground": "#705697",
		"activityBarBadge.background": "#705697",
		"badge.background": "#705697aa",
		"button.background": "#705697",
		"dropdown.background": "#f5f5f5",
		"editor.background": "#f5f5f5",
		"editor.foreground": "#333333",
		"editor.findMatchBackground": "#bf9cac",
		"editor.findMatchHighlightBackground": "#edc9d8",
		"editor.lineHighlightBackground": "#e4f6d4",
		"editor.selectionBackground": "#c9d0d9",
		"editorCursor.foreground": "#54494b",
		"editorGroup.dropBackground": "#c9d0d988",
		"editorIndentGuide.background": "#d3d3d3",
		"editorIndentGuide.activeBackground": "#939393",
		"editorLineNumber.activeForeground": "#9769dc",
		"editorLineNumber.foreground": "#6d705b",
		"editorWhitespace.foreground": "#aaaaaa",
		"errorForeground": "#f1897f",
		"focusBorder": "#a6b39b",
		"inputOption.activeBorder": "#adafb7",
		"inputValidation.errorBackground": "#ffeaea",
		"inputValidation.errorBorder": "#f1897f",
		"inputValidation.infoBackground": "#f2fcff",
		"inputValidation.infoBorder": "#4ec1e5",
		"inputValidation.warningBackground": "#fffee2",
		"inputValidation.warningBorder": "#ffe055",
		"list.activeSelectionBackground": "#c4d9b1",
		"list.activeSelectionForeground": "#6c6c6c",
		"list.focusBackground": "#cadeb9",
		"list.highlightForeground": "#9769dc",
		"list.hoverBackground": "#e0e0e0",
		"list.inactiveSelectionBackground": "#d3dbcd",
		"panel.background": "#f5f5f5",
		"peekView.border": "#705697",
		"peekViewEditor.background": "#f2f8fc",
		"peekViewEditor.matchHighlightBackground": "#c2dfe3",
		"peekViewResult.background": "#f2f8fc",
		"peekViewResult.matchHighlightBackground": "#93c6d6",
		"peekViewTitle.background": "#f2f8fc",
		"pickerGroup.border": "#749351",
		"pickerGroup.foreground": "#a6b39b",
		"progressBar.background": "#705697",
		"selection.background": "#c9d0d9",
		"sideBar.background": "#f2f2f2",
		"sideBarSectionHeader.background": "#ede8ef",
		"statusBar.background": "#705697",
		"statusBar.debuggingBackground": "#705697",
		"statusBar.noFolderBackground": "#705697",
		"titleBar.activeBackground": "#c4b7d7",
		"walkThrough.embeddedEditorBackground": "#00000014"
	},
	"tokenColors": [
		{
			"name": "comment",
			"scope": [
				"comment",
				"comment.line.number-sign.paradox",
				"comment.line.number-sign.cwt",
				"punctuation.definition.comment.paradox",
				"punctuation.definition.comment.cwt"
			],
			"settings": {
				"foreground": "#AAAAAA",
				"fontStyle": "italic"
			}
		},
		{
			"name": "docComment",
			"scope": [
				"comment.documentation",
				"comment.block.documentation",
				"comment.block.documentation.cwt"
			],
			"settings": {
				"foreground": "#8A9A6B",
				"fontStyle": "italic"
			}
		},
		{
			"name": "directive",
			"scope": "comment.line.directive.cwt",
			"settings": {
				"foreground": "#AAAAAA",
				"fontStyle": "italic"
			}
		},
		{
			"name": "directiveKw",
			"scope": "keyword.control.directive.cwt",
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "string",
			"scope": [
				"string",
				"string.quoted.double.paradox",
				"string.quoted.double.cwt",
				"constant.rhs.string.paradox",
				"constant.rhs.paradox"
			],
			"settings": {
				"foreground": "#448C27"
			}
		},
		{
			"name": "stringPunct",
			"scope": [
				"punctuation.definition.string.begin.paradox",
				"punctuation.definition.string.end.paradox",
				"punctuation.definition.string.begin.cwt",
				"punctuation.definition.string.end.cwt"
			],
			"settings": {
				"foreground": "#448C27"
			}
		},
		{
			"name": "escape",
			"scope": [
				"constant.character.escape",
				"constant.character.escape.paradox"
			],
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "number",
			"scope": [
				"constant.numeric",
				"constant.numeric.paradox",
				"constant.numeric.cwt"
			],
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "cardinality",
			"scope": "constant.numeric.cardinality.cwt",
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "langConstant",
			"scope": [
				"constant.language",
				"constant.language.paradox",
				"constant.language.boolean.cwt"
			],
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "boolOp",
			"scope": "variable.boolean.paradox",
			"settings": {
				"foreground": "#4B69C6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "scriptVar",
			"scope": [
				"constant.prefdef.paradox",
				"variable.constant.paradox",
				"variable.other.constant.cwt",
				"punctuation.definition.variable.paradox"
			],
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "key",
			"scope": [
				"variable",
				"variable.other",
				"support.variable",
				"variable.lhs.paradox",
				"variable.paradox",
				"variable.scope.paradox",
				"variable.other.paradox",
				"variable.other.key.cwt"
			],
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "keyBracket",
			"scope": "variable.lhs.bracket.paradox",
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "defToken",
			"scope": "variable.language.definition_tokens.paradox",
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "scopeToken",
			"scope": [
				"variable.language.multi_scopes.paradox",
				"variable.language.command_scopes.paradox",
				"variable.language.condition_scopes.paradox",
				"variable.language.description.scope.paradox",
				"variable.language.scope.cwt"
			],
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "trigger",
			"scope": "variable.language.conditions.paradox",
			"settings": {
				"foreground": "#448C27"
			}
		},
		{
			"name": "effect",
			"scope": [
				"variable.language.effects.paradox",
				"variable.language.other.paradox",
				"variable.language.keywords",
				"variable.bracket.keywords"
			],
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "modifier",
			"scope": "variable.language.modifiers.paradox",
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "description",
			"scope": "variable.language.description.paradox",
			"settings": {
				"foreground": "#448C27"
			}
		},
		{
			"name": "keywordOp",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"keyword.control.paradox",
				"keyword.operator.comparison.cwt",
				"keyword.other.block.cwt",
				"keyword.declaration.construct.cwt"
			],
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "type",
			"scope": [
				"support.type",
				"storage.type",
				"support.type.primitive.cwt"
			],
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "typeRef",
			"scope": [
				"entity.name.type",
				"entity.name.type.reference.cwt",
				"entity.name.type.namespace.txt",
				"entity.name.type.id.txt",
				"entity.name.type.period.txt",
				"entity.name.type.number.txt"
			],
			"settings": {
				"foreground": "#448C27"
			}
		},
		{
			"name": "construct",
			"scope": [
				"entity.name.tag",
				"entity.name.tag.construct.cwt"
			],
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "eventTarget",
			"scope": [
				"event_target.identifier.paradox",
				"event_target.name.paradox",
				"variable.event.target.paradox",
				"punctuation.event_target.colon.paradox"
			],
			"settings": {
				"foreground": "#4B69C6"
			}
		},
		{
			"name": "rhs",
			"scope": "variable.language.rhs.paradox",
			"settings": {
				"foreground": "#333333"
			}
		},
		{
			"name": "namespaceMeta",
			"scope": [
				"meta.namespace.paradox",
				"meta.id.paradox",
				"keyword.other.namespace.txt",
				"keyword.other.id.txt",
				"meta.namespace.identifier.txt",
				"meta.id.identifier.txt"
			],
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "blockPunct",
			"scope": [
				"punctuation",
				"punctuation.section.block.begin.paradox",
				"punctuation.section.block.end.paradox",
				"punctuation.definition.construct.begin.cwt",
				"punctuation.definition.construct.end.cwt",
				"punctuation.definition.type.begin.cwt",
				"punctuation.definition.type.end.cwt"
			],
			"settings": {
				"foreground": "#777777"
			}
		},
		{
			"name": "locFormat",
			"comment": "Loc colour code (§Y ... §!), distinct from langConstant so the colour bar reads as a colour rather than a boolean.",
			"scope": "string.quoted.double.paradox constant.language.paradox",
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"name": "locIcon",
			"comment": "Loc inline icon tag (£gold, £army_experience£). Painted separately so it stands out from £-prefixed script references.",
			"scope": "keyword.other.icon.paradox",
			"settings": {
				"foreground": "#7A3E9D"
			}
		},
		{
			"name": "invalid",
			"comment": "Stray unquoted text in a loc file (bare text outside a quoted value). Painted red so mistakes stand out.",
			"scope": [
				"invalid",
				"invalid.illegal",
				"invalid.illegal.unquoted.paradox"
			],
			"settings": {
				"foreground": "#AA3731"
			}
		}
	],
	"semanticTokenColors": {
		"type": "#267F99",
		"type.declaration": {
			"foreground": "#267F99",
			"bold": true
		},
		"enumMember": "#AF00DB",
		"variable": "#795E26",
		"namespace": "#0451A5",
		"function": "#0F6E3B"
	}
}
