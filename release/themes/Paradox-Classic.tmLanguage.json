{
	"$schema": "vscode://schemas/color-theme",
	"name": "Paradox - Classic",
	"type": "dark",
	"author": "cwtools-md-edition",
	"semanticHighlighting": true,
	"minimal": true,
	"comment": "Token scopes defined by cwtools/paradox-syntax (Thomas Boby, MIT, https://github.com/cwtools/paradox-syntax). Minimal overlay — defers colour to your active VS Code theme, adds only italic comments and bold booleans.",
	"colors": {},
	"tokenColors": [
		{
			"scope": "comment.line.number-sign.paradox",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "variable.boolean.paradox",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable.language.effects.paradox",
				"variable.language.conditions.paradox",
				"variable.language.modifiers.paradox",
				"variable.language.multi_scopes.paradox",
				"variable.language.command_scopes.paradox",
				"variable.language.condition_scopes.paradox",
				"variable.language.definition_tokens.paradox",
				"variable.language.other.paradox",
				"variable.language.description.paradox",
				"variable.language.description.scope.paradox",
				"variable.language.keywords",
				"variable.bracket.keywords",
				"keyword.control.paradox"
			],
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"name": "invalid",
			"comment": "Stray unquoted text in a loc file (bare text outside a quoted value). Painted red so mistakes stand out.",
			"scope": [
				"invalid",
				"invalid.illegal",
				"invalid.illegal.unquoted.paradox"
			],
			"settings": {
				"foreground": "#F44747"
			}
		}
	],
	"semanticTokenColors": {
		"type": "#4EC9B0",
		"type.declaration": {
			"bold": true
		},
		"enumMember": "#C586C0",
		"variable": "#CE9178",
		"namespace": "#569CD6",
		"function": "#DCDCAA"
	}
}
