{
	"$schema": "vscode://schemas/color-theme",
	"name": "Paradox - Nord",
	"type": "dark",
	"author": "cwtools-md-edition",
	"comment": "Token scopes defined by cwtools/paradox-syntax (Thomas Boby, MIT, https://github.com/cwtools/paradox-syntax). Color scheme uses the Nord palette (https://www.nordtheme.com).",
	"colors": {
		"editor.background": "#2E3440",
		"editor.foreground": "#D8DEE9",
		"editor.lineHighlightBackground": "#3B4252",
		"editor.selectionBackground": "#434C5E",
		"editorCursor.foreground": "#D8DEE9",
		"editorLineNumber.foreground": "#4C566A",
		"editorLineNumber.activeForeground": "#D8DEE9",
		"editorIndentGuide.background": "#3B4252",
		"editorIndentGuide.activeBackground": "#434C5E"
	},
	"tokenColors": [
		{
			"name": "comment",
			"scope": [
				"comment",
				"comment.line.number-sign.paradox",
				"comment.line.number-sign.cwt",
				"punctuation.definition.comment.paradox",
				"punctuation.definition.comment.cwt"
			],
			"settings": {
				"foreground": "#616E88",
				"fontStyle": "italic"
			}
		},
		{
			"name": "docComment",
			"scope": [
				"comment.documentation",
				"comment.block.documentation",
				"comment.block.documentation.cwt"
			],
			"settings": {
				"foreground": "#7B88A1",
				"fontStyle": "italic"
			}
		},
		{
			"name": "directive",
			"scope": "comment.line.directive.cwt",
			"settings": {
				"foreground": "#616E88",
				"fontStyle": "italic"
			}
		},
		{
			"name": "directiveKw",
			"scope": "keyword.control.directive.cwt",
			"settings": {
				"foreground": "#81A1C1"
			}
		},
		{
			"name": "string",
			"scope": [
				"string",
				"string.quoted.double.paradox",
				"string.quoted.double.cwt",
				"constant.rhs.string.paradox",
				"constant.rhs.paradox"
			],
			"settings": {
				"foreground": "#A3BE8C"
			}
		},
		{
			"name": "stringPunct",
			"scope": [
				"punctuation.definition.string.begin.paradox",
				"punctuation.definition.string.end.paradox",
				"punctuation.definition.string.begin.cwt",
				"punctuation.definition.string.end.cwt"
			],
			"settings": {
				"foreground": "#A3BE8C"
			}
		},
		{
			"name": "escape",
			"scope": [
				"constant.character.escape",
				"constant.character.escape.paradox"
			],
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "number",
			"scope": [
				"constant.numeric",
				"constant.numeric.paradox",
				"constant.numeric.cwt"
			],
			"settings": {
				"foreground": "#B48EAD"
			}
		},
		{
			"name": "cardinality",
			"scope": "constant.numeric.cardinality.cwt",
			"settings": {
				"foreground": "#B48EAD"
			}
		},
		{
			"name": "langConstant",
			"scope": [
				"constant.language",
				"constant.language.paradox",
				"constant.language.boolean.cwt"
			],
			"settings": {
				"foreground": "#81A1C1"
			}
		},
		{
			"name": "boolOp",
			"scope": "variable.boolean.paradox",
			"settings": {
				"foreground": "#81A1C1",
				"fontStyle": "bold"
			}
		},
		{
			"name": "scriptVar",
			"scope": [
				"constant.prefdef.paradox",
				"variable.constant.paradox",
				"variable.other.constant.cwt",
				"punctuation.definition.variable.paradox"
			],
			"settings": {
				"foreground": "#8FBCBB"
			}
		},
		{
			"name": "key",
			"scope": [
				"variable",
				"variable.other",
				"support.variable",
				"variable.lhs.paradox",
				"variable.paradox",
				"variable.scope.paradox",
				"variable.other.paradox",
				"variable.other.key.cwt"
			],
			"settings": {
				"foreground": "#88C0D0"
			}
		},
		{
			"name": "keyBracket",
			"scope": "variable.lhs.bracket.paradox",
			"settings": {
				"foreground": "#B48EAD"
			}
		},
		{
			"name": "defToken",
			"scope": "variable.language.definition_tokens.paradox",
			"settings": {
				"foreground": "#5E81AC"
			}
		},
		{
			"name": "scopeToken",
			"scope": [
				"variable.language.multi_scopes.paradox",
				"variable.language.command_scopes.paradox",
				"variable.language.condition_scopes.paradox",
				"variable.language.description.scope.paradox",
				"variable.language.scope.cwt"
			],
			"settings": {
				"foreground": "#81A1C1"
			}
		},
		{
			"name": "trigger",
			"scope": "variable.language.conditions.paradox",
			"settings": {
				"foreground": "#8FBCBB"
			}
		},
		{
			"name": "effect",
			"scope": [
				"variable.language.effects.paradox",
				"variable.language.other.paradox",
				"variable.language.keywords",
				"variable.bracket.keywords"
			],
			"settings": {
				"foreground": "#88C0D0"
			}
		},
		{
			"name": "modifier",
			"scope": "variable.language.modifiers.paradox",
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "description",
			"scope": "variable.language.description.paradox",
			"settings": {
				"foreground": "#8FBCBB"
			}
		},
		{
			"name": "keywordOp",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"keyword.control.paradox",
				"keyword.operator.comparison.cwt",
				"keyword.other.block.cwt",
				"keyword.declaration.construct.cwt"
			],
			"settings": {
				"foreground": "#81A1C1"
			}
		},
		{
			"name": "type",
			"scope": [
				"support.type",
				"storage.type",
				"support.type.primitive.cwt"
			],
			"settings": {
				"foreground": "#81A1C1"
			}
		},
		{
			"name": "typeRef",
			"scope": [
				"entity.name.type",
				"entity.name.type.reference.cwt",
				"entity.name.type.namespace.txt",
				"entity.name.type.id.txt",
				"entity.name.type.period.txt",
				"entity.name.type.number.txt"
			],
			"settings": {
				"foreground": "#8FBCBB"
			}
		},
		{
			"name": "construct",
			"scope": [
				"entity.name.tag",
				"entity.name.tag.construct.cwt"
			],
			"settings": {
				"foreground": "#88C0D0"
			}
		},
		{
			"name": "eventTarget",
			"scope": [
				"event_target.identifier.paradox",
				"event_target.name.paradox",
				"variable.event.target.paradox",
				"punctuation.event_target.colon.paradox"
			],
			"settings": {
				"foreground": "#88C0D0"
			}
		},
		{
			"name": "rhs",
			"scope": "variable.language.rhs.paradox",
			"settings": {
				"foreground": "#D8DEE9"
			}
		},
		{
			"name": "namespaceMeta",
			"scope": [
				"meta.namespace.paradox",
				"meta.id.paradox",
				"keyword.other.namespace.txt",
				"keyword.other.id.txt",
				"meta.namespace.identifier.txt",
				"meta.id.identifier.txt"
			],
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "blockPunct",
			"scope": [
				"punctuation",
				"punctuation.section.block.begin.paradox",
				"punctuation.section.block.end.paradox",
				"punctuation.definition.construct.begin.cwt",
				"punctuation.definition.construct.end.cwt",
				"punctuation.definition.type.begin.cwt",
				"punctuation.definition.type.end.cwt"
			],
			"settings": {
				"foreground": "#D8DEE9"
			}
		},
		{
			"name": "locFormat",
			"comment": "Loc colour code (§Y ... §!), distinct from langConstant so the colour bar reads as a colour rather than a boolean.",
			"scope": "string.quoted.double.paradox constant.language.paradox",
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "locIcon",
			"comment": "Loc inline icon tag (£gold, £army_experience£). Painted separately so it stands out from £-prefixed script references.",
			"scope": "keyword.other.icon.paradox",
			"settings": {
				"foreground": "#D08770"
			}
		}
	]
}
