{
	"$schema": "vscode://schemas/color-theme",
	"name": "Paradox-Kate-Light",
	"type": "light",
	"author": "cwtools-md-edition",
	"comment": "Token scopes defined by cwtools/paradox-syntax (Thomas Boby, MIT, https://github.com/cwtools/paradox-syntax). Light color scheme modeled on the Kate syntax's defStyleNum categorization: effects=function, triggers=attribute, modifiers=type, scopes=builtin.",
	"colors": {
		"editor.background": "#FFFFFF",
		"editor.foreground": "#000000",
		"editor.lineHighlightBackground": "#F0F0F0",
		"editorLineNumber.foreground": "#999999",
		"editorLineNumber.activeForeground": "#000000"
	},
	"tokenColors": [
		{
			"scope": "comment.line.number-sign.paradox",
			"settings": {
				"foreground": "#008000",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "string.quoted.double.paradox",
			"settings": {
				"foreground": "#A31515"
			}
		},
		{
			"scope": "constant.character.escape.paradox",
			"settings": {
				"foreground": "#EE0000"
			}
		},
		{
			"scope": "constant.numeric.paradox",
			"settings": {
				"foreground": "#098658"
			}
		},
		{
			"scope": "constant.language.paradox",
			"settings": {
				"foreground": "#0000FF"
			}
		},
		{
			"scope": "constant.rhs.paradox",
			"settings": {
				"foreground": "#A31515"
			}
		},
		{
			"scope": "constant.rhs.string.paradox",
			"settings": {
				"foreground": "#A31515"
			}
		},
		{
			"scope": "constant.prefdef.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "variable.boolean.paradox",
			"settings": {
				"foreground": "#0000FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "variable.constant.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "variable.lhs.paradox",
			"settings": {
				"foreground": "#001080"
			}
		},
		{
			"scope": "variable.lhs.bracket.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.event.target.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "event_target.identifier.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "event_target.name.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "variable.language.effects.paradox",
			"settings": {
				"foreground": "#795E26"
			}
		},
		{
			"scope": "variable.language.conditions.paradox",
			"settings": {
				"foreground": "#001080"
			}
		},
		{
			"scope": "variable.language.modifiers.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "variable.language.multi_scopes.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.language.command_scopes.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.language.condition_scopes.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.language.definition_tokens.paradox",
			"settings": {
				"foreground": "#001080"
			}
		},
		{
			"scope": "variable.language.other.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.language.description.paradox",
			"settings": {
				"foreground": "#001080"
			}
		},
		{
			"scope": "variable.language.description.scope.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.language.keywords",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "variable.bracket.keywords",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "keyword.control.paradox",
			"settings": {
				"foreground": "#AF00DB"
			}
		},
		{
			"scope": "meta.namespace.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "meta.id.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "entity.name.type.namespace.txt",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "entity.name.type.id.txt",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "punctuation.definition.comment.paradox",
			"settings": {
				"foreground": "#008000"
			}
		},
		{
			"scope": "punctuation.definition.string.begin.paradox",
			"settings": {
				"foreground": "#A31515"
			}
		},
		{
			"scope": "punctuation.definition.string.end.paradox",
			"settings": {
				"foreground": "#A31515"
			}
		},
		{
			"scope": "punctuation.definition.variable.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "punctuation.event_target.colon.paradox",
			"settings": {
				"foreground": "#267F99"
			}
		},
		{
			"scope": "punctuation.section.block.begin.paradox",
			"settings": {
				"foreground": "#000000"
			}
		},
		{
			"scope": "punctuation.section.block.end.paradox",
			"settings": {
				"foreground": "#000000"
			}
		}
	]
}
