{
  "scripts": {
    "compile": "tsc -p ./tsconfig.extension.json && tsx build/esbuild.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run compile && vscode-test --label unit",
    "test:watch": "tsc -w -p . & vscode-test --label unit -w",
    "test:host": "npm run compile && vscode-test --label host",
    "test:coverage": "npm run compile && vscode-test --label unit --coverage --coverage-reporter text-summary --coverage-reporter html --coverage-reporter lcov --coverage-reporter json-summary",
    "test:engine:fsharp": "npm run compile && vscode-test --label fsharp",
    "test:engine:rust": "npm run compile && vscode-test --label rust",
    "test:engine:parity": "npm run test:engine:fsharp && npm run test:engine:rust",
    "test:parity": "tsc -p ./tsconfig.extension.json && tsx client/test/parity/prepare.ts && mocha ./release/bin/client/test/parity/parity.test.js",
    "test:parity:fsharp": "tsc -p ./tsconfig.extension.json && tsx client/test/parity/prepare.ts && mocha ./release/bin/client/test/parity/parity.test.js --grep \"\\[fsharp\\]\"",
    "test:parity:rust": "tsc -p ./tsconfig.extension.json && tsx client/test/parity/prepare.ts && mocha ./release/bin/client/test/parity/parity.test.js --grep \"\\[rust\\]\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@types/chai": "^5.2.2",
    "@types/cytoscape-popper": "^2.0.4",
    "@types/merge-images": "^1.2.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.9",
    "@types/sinon": "17.0.4",
    "@types/vscode": "^1.83.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "chai": "^5.2.1",
    "cytoscape": "^3.32.1",
    "cytoscape-elk": "github:jfstephe/cytoscape.js-elk",
    "cytoscape-popper": "^2.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.32.0",
    "glob": "^11.0.3",
    "globals": "^14.0.0",
    "merge-images": "1.2.0",
    "mocha": "^11.7.1",
    "sinon": "21.0.0",
    "tippy.js": "^6.3.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.5",
    "brace-expansion@2": "2.1.1",
    "picomatch@2": "2.3.2",
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "tmp": "0.2.7",
    "undici": "7.27.2",
    "qs": "6.15.2",
    "lodash": "4.18.1",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"
  },
  "engines": {
    "vscode": "^1.83.0"
  }
}
