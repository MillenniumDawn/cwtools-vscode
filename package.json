{
  "scripts": {
    "build": "tsx build/build.ts",
    "compile": "tsc -p ./tsconfig.extension.json && tsx build/esbuild.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run compile && vscode-test --label unit",
    "test:watch": "tsc -w -p . & vscode-test --label unit -w",
    "test:host": "npm run compile && vscode-test --label host",
    "test:coverage": "npm run compile && vscode-test --label unit --coverage",
    "test:node": "vitest run",
    "test:node:watch": "vitest",
    "test:node:coverage": "vitest run --coverage",
    "bench:node": "vitest bench --run"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.2",
    "@types/cytoscape-popper": "^4.0.0",
    "@types/merge-images": "^1.2.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1",
    "@types/sinon": "22.0.0",
    "@types/vscode": "^1.125.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "chai": "^6.2.2",
    "cytoscape": "^3.34.0",
    "cytoscape-elk": "github:jfstephe/cytoscape.js-elk",
    "cytoscape-popper": "^4.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "merge-images": "2.0.0",
    "mocha": "^11.7.1",
    "sinon": "22.1.0",
    "tippy.js": "^6.3.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.5",
    "brace-expansion@2": "2.1.1",
    "picomatch@2": "2.3.2",
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "tmp": "0.2.7",
    "undici": "7.27.2",
    "qs": "6.15.2",
    "lodash": "4.18.1",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"
  },
  "engines": {
    "vscode": "^1.83.0"
  }
}
