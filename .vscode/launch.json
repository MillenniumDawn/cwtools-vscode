{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "Build",
      "name": "Quick update, Build and Launch Extension",
      "type": "extensionHost",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${input:gamePath}",
        "--extensionDevelopmentPath=${workspaceRoot}/dist/extension"
      ],
      "request": "launch",
      "sourceMaps": false,
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "Build",
      "testConfiguration": "${workspaceFolder}/.vscode-test.mjs"
    },
    {
      "preLaunchTask": "BuildDebug",
      "name": "Quick update, Build and Launch Extension (Debug)",
      "type": "extensionHost",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${input:gamePath}",
        "--extensionDevelopmentPath=${workspaceRoot}/dist/extension",
        "--disable-extensions"
      ],
      "request": "launch",
      "sourceMaps": false,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug cwtools",
      "configurations": [
        "Quick update, Build and Launch Extension (Debug)"
      ],
      "presentation": {
        "group": "Full",
        "order": 2
      }
    },
    {
      "name": "Run cwtools (optimised)",
      "configurations": [
        "Quick update, Build and Launch Extension"
      ],
      "presentation": {
        "group": "Full",
        "order": 1
      }
    }
  ],
  "inputs": [
    {
      "id": "gamePath",
      "type": "promptString",
      "description": "Game/mod folder to open in the Extension Host",
      "default": "/mnt/Linux/Millennium-Dawn"
    }
  ]
}
