{
  "name": "cwtools-md-edition",
  "displayName": "%extension.displayName%",
  "private": true,
  "description": "%extension.description%",
  "author": "Millennium Dawn Mod Team",
  "license": "MIT",
  "version": "3.3.0",
  "preview": false,
  "publisher": "milleniumdawnmodteam",
  "qna": "https://github.com/MillenniumDawn/cwtools-vscode/issues",
  "icon": "media/millennium_dawn_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MillenniumDawn/cwtools-vscode"
  },
  "homepage": "https://github.com/MillenniumDawn/cwtools-vscode#readme",
  "bugs": {
    "url": "https://github.com/MillenniumDawn/cwtools-vscode/issues"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "paradox",
    "stellaris",
    "victoria",
    "crusader kings",
    "hearts of iron"
  ],
  "main": "./bin/client/extension/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:descriptor.mod",
    "onWebviewPanel:cwtools-graph"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "cwtools-files",
          "name": "%views.cwtools-files.name%",
          "when": "cwtoolsEnabled"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "when": "view == cwtools-files && cwtoolsFilesLoaded",
          "command": "cwtools-files.revealActiveFile",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "when": "view == cwtools-files && viewItem == file",
          "command": "revealFileInOS",
          "group": "inline"
        },
        {
          "when": "view == cwtools-files && viewItem == file",
          "command": "copyFilePath",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "when": "cwtoolsGraphAvailable && cwtoolsGraphFile == true && cwtoolsWebview == false",
          "command": "cwtools.showGraph",
          "group": "navigation"
        },
        {
          "when": "cwtoolsWebview == true",
          "command": "cwtools.saveGraphImage",
          "group": "navigation"
        },
        {
          "when": "cwtoolsWebview == true",
          "command": "cwtools.setGraphDepth",
          "group": "navigation"
        },
        {
          "when": "cwtoolsWebview == true",
          "command": "cwtools.saveGraphJson",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "revealFileInOS",
          "when": "false"
        },
        {
          "command": "copyFilePath",
          "when": "false"
        },
        {
          "command": "cwtools.showGraph",
          "when": "cwtoolsGraphAvailable"
        },
        {
          "command": "cwtools.setGraphDepth",
          "when": "cwtoolsGraphAvailable"
        },
        {
          "command": "cwtools.fixAllWorkspace",
          "when": "cwtoolsFixAllAvailable"
        },
        {
          "command": "cwtools.formatWorkspace",
          "when": "cwtoolsFormatWorkspaceAvailable"
        }
      ]
    },
    "commands": [
      {
        "command": "genlocall",
        "title": "%commands.genlocall.title%",
        "category": "cwtools"
      },
      {
        "command": "reloadrulesconfig",
        "title": "%commands.reloadrulesconfig.title%",
        "category": "cwtools"
      },
      {
        "command": "cacheVanilla",
        "title": "%commands.cacheVanilla.title%",
        "category": "cwtools"
      },
      {
        "command": "clearAllCaches",
        "title": "%commands.clearAllCaches.title%",
        "category": "cwtools"
      },
      {
        "command": "reindexWorkspace",
        "title": "%commands.reindexWorkspace.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.exportProfilingLog",
        "title": "%commands.exportProfilingLog.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.fixAllWorkspace",
        "title": "%commands.fixAllWorkspace.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.formatWorkspace",
        "title": "%commands.formatWorkspace.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.restartServer",
        "title": "%commands.restartServer.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.showOutput",
        "title": "%commands.showOutput.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.showGraph",
        "title": "%commands.showGraph.title%",
        "category": "cwtools",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cwtools.graphFromJson",
        "title": "%commands.graphFromJson.title%",
        "category": "cwtools"
      },
      {
        "command": "cwtools.saveGraphImage",
        "title": "%commands.saveGraphImage.title%",
        "category": "cwtools",
        "enablement": "cwtoolsWebview == true",
        "icon": "$(device-camera)"
      },
      {
        "command": "cwtools.setGraphDepth",
        "title": "%commands.setGraphDepth.title%",
        "category": "cwtools",
        "enablement": "cwtoolsWebview == true",
        "icon": "$(filter)"
      },
      {
        "command": "cwtools-files.revealActiveFile",
        "title": "%commands.revealActiveFile.title%",
        "category": "cwtools"
      },
      {
        "command": "revealFileInOS",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "copyFilePath",
        "title": "Copy Path"
      },
      {
        "command": "cwtools.saveGraphJson",
        "title": "%commands.saveGraphJson.title%",
        "category": "cwtools",
        "enablement": "cwtoolsWebview == true",
        "icon": "$(json)"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "%configuration.title%",
        "order": 1,
        "properties": {
          "cwtools.rules_folder": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.rules_folder.description%"
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.localisation%",
        "order": 2,
        "properties": {
          "cwtools.localisation.languages": {
            "scope": "window",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "English",
                "French",
                "German",
                "Spanish",
                "Russian",
                "Braz_Por",
                "Polish",
                "Chinese",
                "Korean",
                "Japanese",
                "Turkish"
              ]
            },
            "default": [
              "English"
            ],
            "description": "%configuration.cwtools.localisation.languages.description%",
            "uniqueItems": true
          },
          "cwtools.localisation.hoverShowAllLanguages": {
            "scope": "window",
            "type": "boolean",
            "default": false,
            "description": "%configuration.cwtools.localisation.hoverShowAllLanguages.description%"
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.errors%",
        "order": 3,
        "properties": {
          "cwtools.errors.ignore": {
            "scope": "window",
            "type": "array",
            "items": {
              "type": "string"
            },
            "markdownDescription": "%configuration.cwtools.errors.ignore.description%",
            "uniqueItems": true
          },
          "cwtools.errors.ignorefiles": {
            "scope": "window",
            "type": "array",
            "items": {
              "type": "string"
            },
            "markdownDescription": "%configuration.cwtools.errors.ignorefiles.description%",
            "uniqueItems": true,
            "default": [
              "README.txt",
              "credits.txt",
              "credits_l_simp_chinese.txt",
              "reference.txt",
              "startup_info.txt"
            ]
          },
          "cwtools.ignore_patterns": {
            "scope": "window",
            "type": "array",
            "items": {
              "type": "string"
            },
            "markdownDescription": "%configuration.cwtools.ignore_patterns.description%",
            "uniqueItems": true,
            "default": [
              "**/99_README**.txt"
            ]
          },
          "cwtools.hover.debug": {
            "scope": "window",
            "type": "boolean",
            "default": false,
            "description": "%configuration.cwtools.hover.debug.description%"
          },
          "cwtools.hover.scopeDisplay": {
            "scope": "window",
            "type": "string",
            "enum": [
              "context",
              "resolved"
            ],
            "enumDescriptions": [
              "%configuration.cwtools.hover.scopeDisplay.context%",
              "%configuration.cwtools.hover.scopeDisplay.resolved%"
            ],
            "default": "context",
            "description": "%configuration.cwtools.hover.scopeDisplay.description%"
          },
          "cwtools.inlayHints.locTitles": {
            "scope": "window",
            "type": "boolean",
            "default": true,
            "markdownDescription": "%configuration.cwtools.inlayHints.locTitles.description%"
          },
          "cwtools.inlayHints.scopes": {
            "scope": "window",
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.cwtools.inlayHints.scopes.description%"
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.cache%",
        "order": 4,
        "properties": {
          "cwtools.cache.eu4": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.eu4.description%"
          },
          "cwtools.cache.hoi4": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.hoi4.description%"
          },
          "cwtools.cache.stellaris": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.stellaris.description%"
          },
          "cwtools.cache.ck2": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.ck2.description%"
          },
          "cwtools.cache.imperator": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.imperator.description%"
          },
          "cwtools.cache.vic2": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.vic2.description%"
          },
          "cwtools.cache.ck3": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.ck3.description%"
          },
          "cwtools.cache.vic3": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.vic3.description%"
          },
          "cwtools.cache.eu5": {
            "scope": "application",
            "type": "string",
            "markdownDescription": "%configuration.cwtools.cache.eu5.description%"
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.formatting%",
        "order": 5,
        "properties": {
          "cwtools.formatting.indentStyle": {
            "scope": "window",
            "type": "string",
            "enum": [
              "space",
              "tab"
            ],
            "default": "space",
            "description": "%configuration.cwtools.formatting.indentStyle.description%"
          },
          "cwtools.formatting.indentSize": {
            "scope": "window",
            "type": "number",
            "minimum": 1,
            "maximum": 16,
            "default": 4,
            "description": "%configuration.cwtools.formatting.indentSize.description%"
          },
          "cwtools.formatting.trimTrailingWhitespace": {
            "scope": "window",
            "type": "boolean",
            "default": true,
            "description": "%configuration.cwtools.formatting.trimTrailingWhitespace.description%"
          },
          "cwtools.formatting.insertFinalNewline": {
            "scope": "window",
            "type": "boolean",
            "default": true,
            "description": "%configuration.cwtools.formatting.insertFinalNewline.description%"
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.graph%",
        "order": 6,
        "properties": {
          "cwtools.graph.zoomSensitivity": {
            "scope": "window",
            "type": "number",
            "maximum": 2,
            "minimum": 0,
            "description": "%configuration.cwtools.graph.zoomSensitivity.description%",
            "default": 1
          }
        }
      },
      {
        "type": "object",
        "title": "%configuration.title.advanced%",
        "order": 7,
        "properties": {
          "cwtools.trace.server": {
            "scope": "window",
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "%configuration.cwtools.trace.server.description%"
          },
          "cwtools.profiling": {
            "scope": "window",
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.cwtools.profiling.description%"
          },
          "cwtools.backgroundReindex.intervalMinutes": {
            "scope": "window",
            "type": "number",
            "minimum": 0,
            "default": 30,
            "description": "%configuration.cwtools.backgroundReindex.intervalMinutes.description%"
          },
          "cwtools.backgroundReindex.idleSeconds": {
            "scope": "window",
            "type": "number",
            "minimum": 0,
            "default": 15,
            "description": "%configuration.cwtools.backgroundReindex.idleSeconds.description%"
          }
        }
      }
    ],
    "languages": [
      {
        "id": "paradox",
        "aliases": [
          "paradox",
          "pdxscript"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          "txt",
          "gui",
          "gfx",
          "sfx",
          "asset",
          "map"
        ]
      },
      {
        "id": "cwt",
        "aliases": [
          "CWTools rules",
          "cwt"
        ],
        "extensions": [
          "cwt"
        ],
        "configuration": "./cwt-language-configuration.json"
      },
      {
        "id": "paradox-localisation",
        "aliases": [
          "Paradox Localisation",
          "pdxloc"
        ],
        "filenamePatterns": [
          "**/{localisation,localisation_synced,localization}/**/*.yml",
          "**/{localisation,localisation_synced,localization}/**/*.yaml"
        ],
        "configuration": "./paradox-localisation-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "paradox",
        "scopeName": "source.mod",
        "path": "./syntaxes/paradox.tmLanguage.json"
      },
      {
        "language": "cwt",
        "scopeName": "source.cwt",
        "path": "./syntaxes/cwt.tmLanguage.json"
      },
      {
        "language": "paradox-localisation",
        "scopeName": "source.paradox-localisation",
        "path": "./syntaxes/paradox-localisation.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Paradox - Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-Classic.tmLanguage.json"
      },
      {
        "label": "Paradox - Syntax",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-Syntax.tmLanguage.json"
      },
      {
        "label": "Paradox - Kate",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-Kate.tmLanguage.json"
      },
      {
        "label": "Paradox - Kate Light",
        "uiTheme": "vs",
        "path": "./themes/Paradox-Kate-Light.tmLanguage.json"
      },
      {
        "label": "Paradox - Nord",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-Nord.tmLanguage.json"
      },
      {
        "label": "Paradox - High Contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-HighContrast.tmLanguage.json"
      },
      {
        "label": "Paradox - High Contrast Light",
        "uiTheme": "vs",
        "path": "./themes/Paradox-HighContrast-Light.tmLanguage.json"
      },
      {
        "label": "Paradox - Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/Paradox-Dimmed.tmLanguage.json"
      },
      {
        "label": "Paradox - Quiet Light",
        "uiTheme": "vs",
        "path": "./themes/Paradox-QuietLight.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "paradox",
        "path": "./snippets/paradox.json"
      }
    ],
    "configurationDefaults": {
      "[paradox]": {
        "files.autoGuessEncoding": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.acceptSuggestionOnEnter": "off",
        "editor.suggest.insertMode": "replace",
        "editor.definitionLinkOpensInPeek": true,
        "editor.maxTokenizationLineLength": 10000,
        "editor.semanticHighlighting.enabled": true
      },
      "[yaml]": {
        "files.autoGuessEncoding": true,
        "files.encoding": "utf8bom",
        "editor.insertSpaces": true,
        "editor.autoIndent": "none",
        "editor.wordWrap": "on"
      },
      "[paradox-localisation]": {
        "files.autoGuessEncoding": true,
        "files.encoding": "utf8bom",
        "editor.insertSpaces": true,
        "editor.autoIndent": "none",
        "editor.wordWrap": "on"
      }
    }
  }
}
