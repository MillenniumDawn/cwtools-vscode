{
	"compilerOptions": {
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"target": "es2020",
		"module": "commonjs",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": ["node", "mocha"],
		"rootDir": "extension",
		"outDir": "dist/extension/bin/client",
		"lib": [ "es2020", "dom" ],
		"sourceMap": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"extension"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}